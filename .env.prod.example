# ============================================================================
# FICMS – Production environment (copy to .env and fill).
# NEVER commit real secrets. Never hard-code credentials in source.
# ============================================================================

# --- Postgres ---
POSTGRES_USER=ficms
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=ficms

# --- Object storage (S3-compatible / MinIO) ---
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=change-me-minio-password
S3_BUCKET=ficms
S3_REGION=us-east-1

# --- Auth ---
# Use `openssl rand -base64 48` to generate strong secrets.
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=7d
PLATFORM_BOOTSTRAP_TOKEN=change-me-bootstrap-token

# --- Hosts / origins ---
# Public host used by Caddy/TLS and the web client to talk to the API.
CORS_ORIGINS=https://portal.example.com
PUBLIC_API_HOST=api.example.com

# --- SMTP (optional; console adapter used if empty) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com

# --- Observability ---
LOG_LEVEL=info

# --- Break-glass emergency access (mandatory two-admin approval in production) ---
# Platform admins cannot read clinical data by default. Emergency access requires
# a reason, a second admin's approval, a bounded duration, and full audit logging.
BREAK_GLASS_MAX_MINUTES=60
BREAK_GLASS_ALLOW_SELF_APPROVE=false
