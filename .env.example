# ============================================================================
# FICMS – Environment Variables (example)
# Copy to .env and fill in real values. NEVER commit .env.
# Never hard-code clinic names, branding, or credentials in source.
# ============================================================================

NODE_ENV=development

# --- Postgres -----------------------------------------------------------------
DATABASE_URL=postgresql://ficms:ficms@localhost:5432/ficms?schema=public

# --- Redis (BullMQ queue + rate limiting + cache) ------------------------------
REDIS_URL=redis://localhost:6379

# --- Auth / sessions -----------------------------------------------------------
JWT_ACCESS_SECRET=change-me-32-characters-minimum
JWT_REFRESH_SECRET=change-me-32-characters-minimum
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=7d
COOKIE_SECURE=false
SESSION_TIMEOUT_MINUTES=30
PLATFORM_BOOTSTRAP_TOKEN=change-me-bootstrap-token

# --- API ------------------------------------------------------------------------
API_PORT=4000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# --- Web ------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
PORT=3000

# --- Object storage (S3-compatible) ---------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ficms
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio123
S3_FORCE_PATH_STYLE=true

# --- Notifications (adapters – leave PLACEHOLDER; never hard-code creds) ----------
SMS_PROVIDER=manual
SMS_API_URL=
SMS_API_KEY=
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@{{CLINIC_DOMAIN}}

# --- Payments (adapter config) ---------------------------------------------------
PAYMENT_PROVIDER=offline
PAYMENT_WEBHOOK_SECRET=

# --- Observability ----------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info
