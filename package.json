{
  "name": "ficms",
  "version": "1.0.0",
  "private": true,
  "description": "Universal Fertility & IVF Clinic Management System",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=@ficms/web",
    "dev:api": "turbo run start:dev --filter=@ficms/api",
    "dev:worker": "turbo run dev --filter=@ficms/worker",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:e2e": "turbo run test:e2e",
    "db:generate": "pnpm --filter @ficms/api db:generate",
    "db:migrate": "pnpm --filter @ficms/api db:migrate",
    "db:seed": "pnpm --filter @ficms/api db:seed",
    "db:deploy": "pnpm --filter @ficms/api db:deploy",
    "format": "prettier --write .",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  }
}
